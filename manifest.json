{
  "manifest_version": 3,
  "name": "JS斬り",
  "version": "0.1.0",
  "description": "現在のサイトのJavaScriptをワンクリックで斬り、少数の既知広告・トラッカー通信を遮断します。",
  "minimum_chrome_version": "120",
  "permissions": [
    "contentSettings",
    "storage",
    "tabs",
    "contextMenus",
    "declarativeNetRequest"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "このサイトのJavaScriptを斬る",
    "default_icon": {
      "16": "icons/off/icon-16.png",
      "32": "icons/off/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/on/icon-16.png",
    "48": "icons/on/icon-48.png",
    "128": "icons/on/icon-128.png"
  },
  "options_page": "src/options/index.html",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "basic_ad_tracker_rules",
        "enabled": true,
        "path": "src/rules/block-rules.json"
      }
    ]
  }
}

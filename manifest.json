{
  "manifest_version": 3,
  "name": "JS切り",
  "version": "1.0.1",
  "description": "現在のサイトのJavaScriptをワンクリックで切ります。",
  "minimum_chrome_version": "120",
  "permissions": ["contentSettings", "storage", "tabs", "contextMenus"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "このサイトのJavaScriptを切る",
    "default_icon": {
      "16": "icons/off/icon-16.png",
      "32": "icons/off/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/on/icon-16.png",
    "48": "icons/on/icon-48.png",
    "128": "icons/on/icon-128.png"
  },
  "options_page": "src/options/index.html"
}
